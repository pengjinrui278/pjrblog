---
import '../styles/global.css';
import { SITE, NAV } from '../consts';
import VinylPlayer from '../components/VinylPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  bleed?: string;
}
const { title, description = SITE.description, current = '', bleed = 'home' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}的博客`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- 字体：浏览器走系统代理即可加载；加载失败时回退本地宋体栈 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script is:inline>
      // 在首帧前定下主题，避免闪色：localStorage > 系统偏好
      (function () {
        try {
          var t = localStorage.getItem('xixi-theme');
          if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-bleed={bleed}>
    <!-- 浸染背景：四团多色墨/染料，页面各有配色，feTurbulence 撕出浸润边缘 -->
    <div id="bleed" aria-hidden="true">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="inkbleed" x="-40%" y="-40%" width="180%" height="180%">
            <feTurbulence type="fractalNoise" baseFrequency="0.006 0.010" numOctaves="3" seed="11" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="170" />
            <feGaussianBlur stdDeviation="14" />
          </filter>
        </defs>
        <g filter="url(#inkbleed)">
          <ellipse class="b1" cx="180" cy="130" rx="380" ry="270" />
          <ellipse class="b2" cx="1280" cy="170" rx="320" ry="240" />
          <ellipse class="b3" cx="920" cy="830" rx="400" ry="250" />
          <ellipse class="b4" cx="120" cy="780" rx="280" ry="210" />
        </g>
      </svg>
    </div>
    <div id="readbar"></div>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href="/"><span class="brandmark">曦</span>{SITE.name}</a>
        <nav class="topnav">
          {NAV.map((n) => (
            <a href={n.href} class={current === n.label ? 'on' : ''}>{n.label}</a>
          ))}
        </nav>
        <a class="iconbtn" href="/archive/" title="搜索" aria-label="搜索">⌕</a>
        <a class="writebtn" href="/write/" title="写作工作室">✎ 写</a>
        <button class="iconbtn" id="themeBtn" title="日景 / 夜景" aria-label="切换主题">☾</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.name} · 灯下写作</span>
        <span class="flinks">
          <a href="/rss.xml">RSS</a>
          <a href="/archive/">归档</a>
          <a href="/about/">关于</a>
        </span>
      </div>
    </footer>

    <VinylPlayer />

    <script is:inline>
      // 日夜切换：写 localStorage + 打 data-theme，CSS 三态 token 接管全部颜色
      document.getElementById('themeBtn').addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.getAttribute('data-theme') === 'dark';
        if (dark) { root.removeAttribute('data-theme'); localStorage.setItem('xixi-theme', 'light'); this.textContent = '☾'; }
        else { root.setAttribute('data-theme', 'dark'); localStorage.setItem('xixi-theme', 'dark'); this.textContent = '☀'; }
      });
      if (document.documentElement.getAttribute('data-theme') === 'dark') {
        document.getElementById('themeBtn').textContent = '☀';
      }

      // 阅读进度条
      var bar = document.getElementById('readbar');
      addEventListener('scroll', function () {
        var h = document.documentElement;
        var p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
        bar.style.width = (p * 100).toFixed(2) + '%';
      }, { passive: true });
    </script>
  </body>
</html>
