---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
// 轨道内圈：按 series 归组的复盘文章（系列名 + 序号自动排序）
const seriesMap = new Map<string, typeof posts>();
for (const p of posts) {
  const s = p.data.series;
  if (!s) continue;
  if (!seriesMap.has(s.name)) seriesMap.set(s.name, []);
  seriesMap.get(s.name)!.push(p);
}
const innerItems: { href: string; label: string }[] = [];
for (const [name, list] of seriesMap) {
  list.sort((a, b) => a.data.series!.order - b.data.series!.order);
  list.forEach((p, i) => innerItems.push({ href: `/posts/${p.id}/`, label: `${name} · ${i + 1}` }));
}
if (!innerItems.length) innerItems.push({ href: '/write/?type=post', label: '轨道虚位 · 写下第一篇系列复盘' });
---
<Base title="实验室" current="实验室" bleed="lab">
  <div class="wrap">
    <div style="padding:52px 0 0">
      <div class="eyebrow">Workbench</div>
      <h1 class="pagetitle">实验室</h1>
      <p class="lede">工坊台在转：中心是正在敲打的作品，环绕的是它牵出的文章。悬停暂停，点击直达。给文章填上系列名，它就会自动挂上轨道。</p>
    </div>

    <div class="orbit-stage">
      <div class="orbit-core"><Icon name="bot" size={30} /><br/>曦曦的<br/>工坊</div>
      <div class="orbit-ring r1">
        {innerItems.slice(0, 3).map((it, i) => (
          <div class="orbit-item" style={`animation-delay:${(-i * 40 / 3).toFixed(1)}s`}>
            <a href={it.href}>{it.label}</a>
          </div>
        ))}
      </div>
      <div class="orbit-ring r2">
        {[
          { href: '/travel/', label: '旅程地图', icon: 'compass' },
          { href: '/board/', label: '灵感墙', icon: 'bulb' },
          { href: '/movies/', label: '观影墙', icon: 'film' },
        ].map((it, i) => (
          <div class="orbit-item" style={`--rx:250px;--dur:70s;animation-delay:${(-i * 70 / 3).toFixed(1)}s`}>
            <a href={it.href}><Icon name={it.icon} size={13} /> {it.label}</a>
          </div>
        ))}
      </div>
    </div>

    <section class="block" id="workbenches">
      <h2>工位</h2>
      <div class="bench" style="grid-template-columns:1fr 1fr">
        <div class="tool">
          <div class="tt"><Icon name="code" size={18} /> 工位一 · 虚位以待</div>
          <div class="td">放你的第一个项目：它是什么、做到哪一步、下一步是什么。直接告诉我帮你排版，或自己动手改 <code>src/pages/lab/index.astro</code>。</div>
        </div>
        <div class="tool">
          <div class="tt"><Icon name="camera" size={18} /> 工位二 · 虚位以待</div>
          <div class="td">第二个作品的位置也留好了。照片、Demo 链接、踩坑记录都可以钉在这里。</div>
        </div>
      </div>
    </section>
  </div>
</Base>
