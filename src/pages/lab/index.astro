---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const inSeries = (name: string, order: number) =>
  posts.find((p) => p.data.series?.name === name && p.data.series?.order === order);
---
<Base title="实验室" current="实验室" bleed="lab">
  <div class="wrap">
    <div style="padding:52px 0 0">
      <div class="eyebrow">Workbench</div>
      <h1 class="pagetitle">实验室</h1>
      <p class="lede">工坊台在转：中心是正在敲打的作品，环绕的是它牵出的文章与兄弟项目。悬停暂停，点击直达。</p>
    </div>

    <div class="orbit-stage">
      <div class="orbit-core">🤖<br/>ReAct<br/>Agent 框架</div>
      <div class="orbit-ring r1">
        {[
          { href: inSeries('造一个 Agent', 1) ? `/posts/${inSeries('造一个 Agent', 1)!.id}/` : '/posts/', label: '① 引擎复盘' },
          { href: inSeries('造一个 Agent', 2) ? `/posts/${inSeries('造一个 Agent', 2)!.id}/` : '/posts/', label: '② 工具注册表' },
          { href: '/write/?type=post', label: '③ 记忆系统 · 待写' },
        ].map((it, i) => (
          <div class="orbit-item" style={`animation-delay:${(-i * 40 / 3).toFixed(1)}s`}>
            <a href={it.href}>{it.label}</a>
          </div>
        ))}
      </div>
      <div class="orbit-ring r2">
        {[
          { href: '#camera', label: '📷 AI 构图相机' },
          { href: '#blog', label: '🧱 博客本身' },
          { href: '/board/', label: '📌 灵感墙' },
        ].map((it, i) => (
          <div class="orbit-item" style={`--rx:250px;--dur:70s;animation-delay:${(-i * 70 / 3).toFixed(1)}s`}>
            <a href={it.href}>{it.label}</a>
          </div>
        ))}
      </div>
    </div>

    <section class="block" id="camera">
      <h2>📷 AI 构图辅助相机</h2>
      <div class="bench" style="grid-template-columns:1fr 1fr">
        <div class="tool">
          <div class="tt">它是什么</div>
          <div class="td">用 ML Kit 几何检测辅助构图的 Android 相机：三分法、对称、引导线实时评分，让"拍得好"有章可循。</div>
        </div>
        <div class="tool">
          <div class="tt">现状与下一步</div>
          <div class="td">2026-07-26 大整改：P0-P3 全修复、V9 链路接通、编译与 14 项单测全绿。下一步真机验收 + ML Kit 几何检测落地。</div>
        </div>
      </div>
    </section>

    <section class="block" id="blog">
      <h2>🧱 这间书房本身</h2>
      <div class="bench" style="grid-template-columns:1fr 1fr">
        <div class="tool">
          <div class="tt">它是什么</div>
          <div class="td">你正在看的这个博客：Astro 静态站、暖纸日夜双景、唱片机、旅程地图、浸染背景。设计稿先于代码，代码即文章。</div>
        </div>
        <div class="tool">
          <div class="tt">为什么也算作品</div>
          <div class="td">它是需求收敛方法的证明：三轮问话 → 设计稿 → 动工。这套流程本身，就是实验室要沉淀的东西。</div>
        </div>
      </div>
    </section>
  </div>
</Base>
