---
// 全局唱机设备台：吧台形态（A2）+ 水墨盘（B3）+ 自由拖拽记忆位置（C2）+ 滑出歌单（D3）。
// 三条播放路径（本地文件 > QQ 在线 > 外链兜底），随机播放，可整单加载 QQ 歌单。
// transition:persist → 页面软切换时元素不被重建，跨页面连续播放。
import { PLAYLIST, QQ_PLAYLIST_ID } from '../consts';
import Icon from './Icon.astro';
---
<div id="player" aria-label="唱机设备台" transition:persist="player">
  <div class="vinyl-wrap">
    <div class="vinyl"><span class="label">曦</span></div>
    <span class="p-arm"></span>
  </div>
  <div class="p-mid">
    <div class="p-info">
      <span class="sn" id="pName">{PLAYLIST[0]?.name ?? '灯下常听'}</span>
      <span class="sa" id="pArtist">{PLAYLIST[0]?.artist ?? ''}</span>
    </div>
    <div class="p-prog">
      <div class="pbar" id="pBar"><i id="pBarFill"></i></div>
      <span class="ptime" id="pTime">0:00 / 0:00</span>
    </div>
  </div>
  <div class="p-ctrl">
    <button id="pShuffle" title="随机播放"><Icon name="shuffle" size={15} /></button>
    <button id="pListBtn" title="歌单"><Icon name="list" size={15} /></button>
    <button id="pPrev" title="上一首"><Icon name="prev" size={15} /></button>
    <button class="play" id="pPlay" title="播放 / 暂停"><Icon name="play" size={17} /></button>
    <button id="pNext" title="下一首"><Icon name="next" size={15} /></button>
  </div>
  <button class="toggle" id="playerToggle" title="收起 / 展开"><Icon name="music" size={14} /></button>
  <audio id="pAudio" preload="none"></audio>
  <div class="playlist" id="pPlaylist">
    <div class="ph2">歌单「灯下常听」· QQ 音乐源</div>
    <ul class="plist2" id="pListUl"></ul>
  </div>
</div>

<script define:vars={{ playlist: PLAYLIST, qqPlaylistId: QQ_PLAYLIST_ID }}>
  (function () {
    if (window.__xixiPlayerInit) return; // 页面软切换后内联脚本可能重跑：只初始化一次
    window.__xixiPlayerInit = true;
    var player = document.getElementById('player');
    var audio = document.getElementById('pAudio');
    var list = (playlist || []).map(function (s) { return { mid: s.mid, name: s.name, artist: s.artist, file: s.file || '' }; });
    var idx = 0, urls = {}, shuffle = false, bag = [];

    /* ---------- 内联 SVG 图标（与 Icon.astro 同套笔画） ---------- */
    function ic(inner, size) {
      return '<svg width="' + (size || 14) + '" height="' + (size || 14) + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + inner + '</svg>';
    }
    var I_PLAY = ic('<polygon points="7 4 20 12 7 20" fill="currentColor" stroke="none"/>', 17);
    var I_PAUSE = ic('<rect x="6" y="4" width="4" height="16" fill="currentColor" stroke="none"/><rect x="14" y="4" width="4" height="16" fill="currentColor" stroke="none"/>', 17);
    var I_TRI = ic('<polygon points="7 4 20 12 7 20" fill="currentColor" stroke="none"/>', 9);

    // 收起/展开（迷你态收成一张小碟）
    document.getElementById('playerToggle').addEventListener('click', function () {
      player.classList.toggle('min');
    });

    // 歌单渲染（重渲染整个列表以保持高亮正确）
    var ul = document.getElementById('pListUl');
    function renderList() {
      ul.innerHTML = '';
      list.forEach(function (s, i) {
        var li = document.createElement('li');
        li.innerHTML = '<span class="eq">' + (i === idx ? I_TRI : '<i class="dot">·</i>') + '</span>' +
          '<span class="n">' + s.name + ' <span>— ' + s.artist + '</span></span>' +
          '<span class="dur">' + (s.file ? '本地' : 'QQ') + '</span>';
        if (i === idx) li.classList.add('playing');
        li.addEventListener('click', function () { playAt(i); });
        ul.appendChild(li);
      });
    }
    renderList();

    // 若配置了 QQ 歌单 ID，整单并入
    if (qqPlaylistId) {
      fetch('/api/qqmusic/playlist?id=' + encodeURIComponent(qqPlaylistId))
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j.list || !j.list.length) return;
          j.list.forEach(function (s) {
            if (!list.some(function (x) { return x.mid === s.mid; })) {
              list.push({ mid: s.mid, name: s.name, artist: s.artist, file: '' });
            }
          });
          renderList();
          document.querySelector('#pPlaylist .ph2').textContent = '歌单「灯下常听」+ QQ 歌单 · 共 ' + list.length + ' 首';
        })
        .catch(function () {
          // 歌单详情需要登录态：明示原因，本地歌单照常可用
          document.querySelector('#pPlaylist .ph2').textContent = 'QQ 歌单需配置 QQ_MUSIC_COOKIE · 先用本地歌单';
        });
    }

    // 滑出歌单；贴左缘时改从左侧伸出，防止出屏
    document.getElementById('pListBtn').addEventListener('click', function () {
      var pl = document.getElementById('pPlaylist');
      pl.classList.toggle('open');
      if (pl.classList.contains('open')) {
        var hugLeft = player.getBoundingClientRect().right < 290;
        pl.style.right = hugLeft ? 'auto' : '';
        pl.style.left = hugLeft ? '0' : '';
      }
    });

    /* ---------- 🔀 随机播放 ---------- */
    var shuffleBtn = document.getElementById('pShuffle');
    function refillBag(except) {
      bag = list.map(function (_, i) { return i; }).filter(function (i) { return i !== except; });
      // Fisher–Yates
      for (var i = bag.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = bag[i]; bag[i] = bag[j]; bag[j] = t;
      }
    }
    function nextIndex() {
      if (!list.length) return 0;
      if (shuffle) {
        if (!bag.length) refillBag(idx);
        return bag.pop();
      }
      return (idx + 1) % list.length;
    }
    function prevIndex() {
      if (!list.length) return 0;
      if (shuffle) {
        if (!bag.length) refillBag(idx);
        return bag.shift();
      }
      return (idx - 1 + list.length) % list.length;
    }
    shuffleBtn.addEventListener('click', function () {
      shuffle = !shuffle;
      shuffleBtn.style.color = shuffle ? 'var(--seal)' : '';
      shuffleBtn.style.opacity = shuffle ? '1' : '.65';
      if (shuffle) { refillBag(idx); player.classList.remove('min'); }
    });

    function fmt(sec) {
      if (!isFinite(sec)) return '0:00';
      var m = Math.floor(sec / 60), s = Math.floor(sec % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    }

    /* ---------- 解析播放地址：本地文件 > QQ 代理 > 外链兜底 ---------- */
    async function resolveUrl(s) {
      if (s.file) return encodeURI(s.file);            // 路径一：本地文件，永远可用（编码空格/中文）
      if (urls[s.mid]) return urls[s.mid];             // 缓存
      var r = await fetch('/api/qqmusic/url?mid=' + encodeURIComponent(s.mid));
      if (!r.ok) throw new Error('qq ' + r.status);
      var j = await r.json();
      if (!j.url) throw new Error(j.code || 'no url');
      urls[s.mid] = j.url;
      return j.url;
    }

    function setRestricted(s) {
      player.classList.remove('playing');
      document.getElementById('pPlay').innerHTML = I_PLAY;
      document.getElementById('pArtist').innerHTML =
        '<a href="https://y.qq.com/n/ryqq/songDetail/' + s.mid + '" target="_blank" rel="noopener" style="color:var(--seal)">播放受限 · 去 QQ 音乐听 ↗</a>';
    }

    async function playAt(i) {
      if (!list.length) return;
      idx = ((i % list.length) + list.length) % list.length;
      var s = list[idx];
      document.getElementById('pName').textContent = s.name;
      document.getElementById('pArtist').textContent = s.artist;
      renderList();
      try {
        var url = await resolveUrl(s);
        audio.src = url;
        await audio.play();
        player.classList.add('playing');
        document.getElementById('pPlay').innerHTML = I_PAUSE;
        document.getElementById('pArtist').textContent = s.artist;
      } catch (e) {
        setRestricted(s);
      }
    }

    document.getElementById('pPlay').addEventListener('click', function () {
      if (!audio.src) { playAt(idx); return; }
      if (audio.paused) { audio.play(); player.classList.add('playing'); this.innerHTML = I_PAUSE; }
      else { audio.pause(); player.classList.remove('playing'); this.innerHTML = I_PLAY; }
    });
    document.getElementById('pPrev').addEventListener('click', function () { playAt(prevIndex()); });
    document.getElementById('pNext').addEventListener('click', function () { playAt(nextIndex()); });

    audio.addEventListener('timeupdate', function () {
      var p = audio.currentTime / (audio.duration || 1);
      document.getElementById('pBarFill').style.width = (p * 100).toFixed(1) + '%';
      document.getElementById('pTime').textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
    });
    // 播完自动下一首（随机模式下随机跳）
    audio.addEventListener('ended', function () { playAt(nextIndex()); });

    // 进度条拖动
    document.getElementById('pBar').addEventListener('click', function (e) {
      if (!audio.duration) return;
      var r = this.getBoundingClientRect();
      audio.currentTime = (e.clientX - r.left) / r.width * audio.duration;
    });

    /* ---------- 文章 BGM / 地图"那首歌"联动（事件委托） ---------- */
    document.addEventListener('click', function (ev) {
      var chip = ev.target.closest ? ev.target.closest('.bgm-chip[data-mid]') : null;
      if (!chip) return;
      var mid = chip.getAttribute('data-mid');
      var i = list.findIndex(function (s) { return s.mid === mid; });
      if (i >= 0) { playAt(i); player.classList.remove('min'); }
      else {
        var tmp = { mid: mid, name: chip.getAttribute('data-name') || '本篇 BGM', artist: chip.getAttribute('data-artist') || '', file: '' };
        list.splice(idx + 1, 0, tmp);
        renderList();
        playAt(idx + 1);
        player.classList.remove('min');
      }
    });

    /* ---------- 自由拖拽（C2）：拖走即"设备台"，位置永久记住 ---------- */
    var POS_KEY = 'xixi-player-pos';
    var pid = null, moved = false, sx = 0, sy = 0, sl = 0, st = 0;
    function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }
    function isMobile() { return window.matchMedia('(max-width: 560px)').matches; }

    // 恢复上次拖放的位置
    try {
      var saved = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
      if (saved && isFinite(saved.x) && isFinite(saved.y)) {
        player.classList.add('floating');
        player.style.left = clamp(saved.x, 0, window.innerWidth - 120) + 'px';
        player.style.top = clamp(saved.y, 0, window.innerHeight - 60) + 'px';
      }
    } catch (e) { /* 无存档则停靠底部居中 */ }

    player.addEventListener('pointerdown', function (e) {
      if (isMobile()) return;                                            // 手机：底部通栏，不拖
      if (e.target.closest('button, a, input, .pbar, .playlist, audio')) return; // 交互元素照常工作
      pid = e.pointerId; moved = false;
      var r = player.getBoundingClientRect();
      sx = e.clientX; sy = e.clientY; sl = r.left; st = r.top;
      player.setPointerCapture(pid);
      e.preventDefault();
    });
    player.addEventListener('pointermove', function (e) {
      if (pid === null || e.pointerId !== pid) return;
      var dx = e.clientX - sx, dy = e.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) < 4) return;             // 4px 以内算点击，不拖
      if (!moved) { moved = true; player.classList.add('floating', 'dragging'); }
      var w = player.offsetWidth, h = player.offsetHeight;
      player.style.left = clamp(sl + dx, 0, window.innerWidth - w) + 'px';
      player.style.top = clamp(st + dy, 0, window.innerHeight - h) + 'px';
    });
    function endDrag(e) {
      if (pid === null || (e && e.pointerId !== pid)) return;
      pid = null;
      player.classList.remove('dragging');
      if (moved) {
        try {
          localStorage.setItem(POS_KEY, JSON.stringify({ x: parseFloat(player.style.left), y: parseFloat(player.style.top) }));
        } catch (err) { /* 私密模式等场景写不进就下次再记 */ }
      }
    }
    player.addEventListener('pointerup', endDrag);
    player.addEventListener('pointercancel', endDrag);

    // 窗口缩放：窄屏退出悬浮回归通栏；宽屏则把悬浮位置夹回视口内
    window.addEventListener('resize', function () {
      if (isMobile() && player.classList.contains('floating')) {
        player.classList.remove('floating');
        player.style.left = player.style.top = '';
        try { localStorage.removeItem(POS_KEY); } catch (e) {}
        return;
      }
      if (!player.classList.contains('floating')) return;
      var w = player.offsetWidth, h = player.offsetHeight;
      player.style.left = clamp(parseFloat(player.style.left) || 0, 0, window.innerWidth - w) + 'px';
      player.style.top = clamp(parseFloat(player.style.top) || 0, 0, window.innerHeight - h) + 'px';
    });
  })();
</script>
